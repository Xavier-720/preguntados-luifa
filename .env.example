# Copiá este archivo como .env para personalizar docker compose.
# Los valores de abajo son los predeterminados de desarrollo.

POSTGRES_DB=preguntados
POSTGRES_USER=preguntados
POSTGRES_PASSWORD=cambiame-en-produccion

# PIN del panel de administración. Cambialo antes de publicar.
ADMIN_PIN=2468
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Puertos publicados en el host.
BACKEND_PORT=8080
FRONTEND_PORT=8081

# Orígenes permitidos para llamadas directas a la API (el frontend usa nginx como proxy).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
